seq = input("Enter the Protein Sequence: ").upper()

print("\nProtein Sequence:", seq)

# Amino Acid Count
amino = "ACDEFGHIKLMNPQRSTVWY"

for aa in amino:
    count = seq.count(aa)

    if count > 0:
        print(aa, ":", count)

# Approximate Molecular Weight
wt = len(seq) * 110

print("Total Weight is:", wt, "Dalton")

